[
 {
  "name": "capabilities are public and say who the game is",
  "route": "GET /api/console/capabilities",
  "expect": {
   "status": 200,
   "schema": "Capabilities",
   "checks": [
    {
     "path": "bridge",
     "eq": 1
    },
    {
     "path": "kids",
     "lengthGte": 1
    },
    {
     "path": "sizes",
     "lengthGte": 8
    }
   ]
  }
 },
 {
  "name": "session: a known person gets an organizer key that lives 2 hours and is labelled console",
  "route": "POST /api/console/session",
  "requestSchema": "SessionRequest",
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice"
    }
   }
  },
  "expect": {
   "status": 200,
   "schema": "SessionResponse",
   "checks": [
    {
     "path": "created",
     "eq": false
    },
    {
     "path": "organizer.label",
     "eq": "console"
    }
   ]
  },
  "fakeOnly": true
 },
 {
  "name": "session: Host keys come back bound to one game",
  "route": "POST /api/console/session",
  "fakeOnly": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice"
    }
   }
  },
  "expect": {
   "status": 200,
   "schema": "SessionResponse",
   "checks": [
    {
     "path": "scoped.0.eid",
     "eq": "BOBS001"
    },
    {
     "path": "scoped.0.role",
     "eq": "host"
    },
    {
     "path": "scoped.length",
     "eq": 1
    }
   ]
  }
 },
 {
  "name": "session: an unknown person without 'create' gets nothing and nothing is made",
  "route": "POST /api/console/session",
  "fakeOnly": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "nobody"
    }
   }
  },
  "expect": {
   "status": 200,
   "schema": "SessionResponse",
   "checks": [
    {
     "path": "created",
     "eq": false
    },
    {
     "path": "organizer",
     "eq": null
    },
    {
     "path": "scoped.length",
     "eq": 0
    }
   ]
  }
 },
 {
  "name": "session: an account is made only when the assertion carries the proven e-mail AND the request asks for it",
  "route": "POST /api/console/session",
  "fakeOnly": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "dave",
     "withEm": true
    }
   },
   "create": true
  },
  "expect": {
   "status": 200,
   "schema": "SessionResponse",
   "checks": [
    {
     "path": "created",
     "eq": true
    },
    {
     "path": "organizer.label",
     "eq": "console"
    }
   ]
  }
 },
 {
  "name": "session: 'create' without the e-mail claim makes no account",
  "route": "POST /api/console/session",
  "fakeOnly": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "dave"
    }
   },
   "create": true
  },
  "expect": {
   "status": 200,
   "schema": "SessionResponse",
   "checks": [
    {
     "path": "created",
     "eq": false
    },
    {
     "path": "organizer",
     "eq": null
    }
   ]
  }
 },
 {
  "name": "refused: assertion made for another game",
  "route": "POST /api/console/session",
  "negative": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice",
     "mutate": {
      "aud": "https://other.corporatetambola.com"
     }
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "wrong_audience"
    }
   ]
  }
 },
 {
  "name": "refused: assertion older than its 60 seconds plus 30 seconds of clock difference",
  "route": "POST /api/console/session",
  "negative": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice",
     "mutate": {
      "iatOffsetS": -200,
      "expOffsetS": -200
     }
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "expired"
    }
   ]
  }
 },
 {
  "name": "refused: assertion signed by a key the game does not know",
  "route": "POST /api/console/session",
  "negative": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice",
     "mutate": {
      "forge": true
     }
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "bad_assertion"
    }
   ]
  }
 },
 {
  "name": "refused: unknown key id",
  "route": "POST /api/console/session",
  "negative": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice",
     "mutate": {
      "kid": "k9"
     }
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "unknown_kid"
    }
   ]
  }
 },
 {
  "name": "refused: assertion for the list used to open a session",
  "route": "POST /api/console/session",
  "negative": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "games",
     "person": "alice"
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "wrong_act"
    }
   ]
  }
 },
 {
  "name": "refused: the same assertion used twice",
  "route": "POST /api/console/session",
  "negative": true,
  "replay": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice"
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "replayed"
    }
   ]
  }
 },
 {
  "name": "refused: an assertion whose payload lost its audience is not accepted",
  "route": "POST /api/console/session",
  "negative": true,
  "payloadMustBeValid": true,
  "body": {
   "assertion": {
    "$sign": {
     "act": "session",
     "person": "alice",
     "mutate": {
      "drop": [
       "aud"
      ]
     }
    }
   }
  },
  "expect": {
   "status": 401,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "wrong_audience"
    }
   ]
  }
 },
 {
  "name": "games: the list has the standard fields",
  "route": "POST /api/console/games",
  "requestSchema": "ListRequest",
  "body": {
   "assertion": {
    "$sign": {
     "act": "games",
     "person": "alice"
    }
   }
  },
  "expect": {
   "status": 200,
   "schema": "GamesResponse"
  }
 },
 {
  "name": "games: Organizer, Host and (not yet accepted) Co-host rows, one status each",
  "route": "POST /api/console/games",
