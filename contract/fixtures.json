    }
   ]
  }
 },
 {
  "name": "role invite: refused without a fresh confirmation (step-up)",
  "route": "POST /api/console/role",
  "key": "alice/organizer",
  "negative": true,
  "fakeOnly": true,
  "body": {
   "op": "invite",
   "eid": "READY01",
   "role": "cohost",
   "email": "helper@acme.example"
  },
  "expect": {
   "status": 403,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "step_up_required"
    }
   ]
  }
 },
 {
  "name": "role invite: a confirmation for a different action does not count",
  "route": "POST /api/console/role",
  "key": "alice/organizer",
  "negative": true,
  "fakeOnly": true,
  "step": {
   "act": "stepup",
   "sa": "pay",
   "eid": "READY01",
   "person": "alice"
  },
  "body": {
   "op": "invite",
   "eid": "READY01",
   "role": "cohost",
   "email": "helper@acme.example"
  },
  "expect": {
   "status": 403,
   "schema": "Error",
   "checks": [
    {
     "path": "error",
     "eq": "step_up_required"
    }
   ]
  }
 },
 {
  "name": "role invite: with the confirmation one invitation is made",
  "route": "POST /api/console/role",
